{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/notice/:id",
      "destination": "/notice-detail"
    },
    {
      "source": "/2",
      "destination": "/index"
    },
    {
      "source": "/c/:id",
      "destination": "/api/c/:id"
    },
    {
      "source": "/r/:code",
      "destination": "/api/r/:code"
    },
    {
      "source": "/communityflow",
      "destination": "https://apepe-communityflow.vercel.app/"
    },
    {
      "source": "/communityflow/:path*",
      "destination": "https://apepe-communityflow.vercel.app/:path*"
    },
    {
      "source": "/memeaistudio",
      "destination": "https://apepe-meme-ai-studio-nu.vercel.app/memeaistudio"
    },
    {
      "source": "/memeaistudio/:path*",
      "destination": "https://apepe-meme-ai-studio-nu.vercel.app/memeaistudio/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/form",
      "destination": "/communityflow/form",
      "permanent": false
    },
    {
      "source": "/vote",
      "destination": "/communityflow/vote",
      "permanent": false
    },
    {
      "source": "/result",
      "destination": "/communityflow/result",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}