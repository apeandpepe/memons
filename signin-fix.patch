-  el('wbtn').onclick=doConnect; el('wicon').onclick=doConnect; el('mpbtn').onclick=function(){location.href='mypage-collection.html';};
+  /* Through the shared sheet, so Google is offered here too. doConnect
+     stays as the fallback for a page loaded without social-login.js. */
